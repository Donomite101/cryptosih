# Copy this file to ".env" and fill in your own keys. Never commit ".env".

# REQUIRED - free key from https://etherscan.io/apis (one key covers Ethereum, Polygon, Arbitrum, Linea)
ETHERSCAN_API_KEY=

# OPTIONAL but recommended for Tron traces - free key from https://www.trongrid.io
# Without it Tron lookups are throttled to ~1 request/second and may hit rate limits.
TRONGRID_API_KEY=

# Database (SQLite file is created automatically in the project root)
DATABASE_URL=sqlite:///./tech_titans.db

# Exchange / mixer label list used for attribution
VASP_LABELS_FILE=./data/vasp_labels.csv

APP_ENV=development
